{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator-router",
  "share": "disabled",
  "instructions": [
    ".opencode/dev_harness/instructions.md"
  ],
  "provider": {
    "openrouter": {
      "models": {
        "deepseek/deepseek-v4-flash": {
          "options": {
            "provider": {
              "ignore": [
                "gmicloud",
                "SiliconFlow",
                "Baidu"
              ],
              "allow_fallbacks": false
            }
          }
        }
      }
    }
  }
}